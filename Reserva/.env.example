# ==============================================================================
# Archivo de ejemplo de variables de entorno (.env.example)
# COPIA este archivo como '.env' y completa con tus credenciales seguras.
# NUNCA subas el archivo '.env' a GitHub (ya incluido en .gitignore).
# ==============================================================================

# Entorno de Flask
FLASK_ENV=development
FLASK_CONFIG=development
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
SECRET_KEY=cambiar_por_clave_secreta_super_segura_2026

# Configuración de Base de Datos PostgreSQL
POSTGRES_DB=sistema_reserva
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contrasena_segura_aqui
POSTGRES_PORT=5432

# URL de Conexión a la Base de Datos para Docker Compose
# NOTA IMPORTANTE (Criterio 5): El host 'db' corresponde al nombre del servicio en docker-compose
DATABASE_URL=postgresql://postgres:tu_contrasena_segura_aqui@db:5432/sistema_reserva

# Configuración de Administrador por defecto
ADMIN_USER=admin
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=AdminSeguro2026*
SUPERADMIN_DOCUMENTS=80140666
